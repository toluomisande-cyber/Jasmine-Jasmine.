# ==============================================================================
# Jasmine Personal Assistant Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local
#
# Google Cloud OAuth Redirect URI:
#   http://localhost:3000/api/auth/callback/google
# ==============================================================================

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
TAVILY_API_KEY=
DATABASE_URL=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Fish Audio Cloned Voice TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=5bac2db6b75b400d9a0f2c257a6da812
FISH_AUDIO_MODEL=s2.1-pro-free

